[Unit]
Description=Backup do banco de dados Crediario
After=network-online.target network.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ovidio-neto/Crediario/backend/scripts
ExecStart=/home/ovidio-neto/.nvm/versions/node/v24.14.1/bin/node /home/ovidio-neto/Crediario/backend/scripts/backup.js
StandardOutput=append:/home/ovidio-neto/Crediario/backend/Logs/backup.log
StandardError=append:/home/ovidio-neto/Crediario/backend/Logs/backup.log
ProtectSystem=strict
ReadWritePaths=/home/ovidio-neto/Crediario/
ProtectHome=read-only
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target