[Unit]
Description=Backup do banco de dados Crediario
After=network-online.target network.target crediario-backup.timer
Wants=network-online.target crediario-backup.timer

[Service]
Type=oneshot
WorkingDirectory=/home/ovidio-neto/Crediario/backend/backups
ExecStart=/home/ovidio-neto/.nvm/versions/node/v24.14.1/bin/node /home/ovidio-neto/Crediario/backend/backups/backup.js
StandardOutput=append:/home/ovidio-neto/Crediario/backend/backups/backup.log
StandardError=inherit
ProtectSystem=strict
ReadWritePaths=/home/ovidio-neto/Crediario/
ProtectHome=read-only
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target