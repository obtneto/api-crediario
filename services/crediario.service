[Unit]
Description=Atualiza status de Vendas e Cobranças e distribuições
After=network-online.target network.target crediario.timer
Wants=network-online.target crediario.timer

[Service]
Type=oneshot
WorkingDirectory=/home/ovidio-neto/Crediario/backend/services
ExecStart=/home/ovidio-neto/.nvm/versions/node/v24.14.1/bin/node /home/ovidio-neto/Crediario/backend/scripts/update_status.js
StandardOutput=append:/home/ovidio-neto/Crediario/backend/Logs/update_status.log
StandardError=inherit
ProtectSystem=strict
ReadWritePaths=/home/ovidio-neto/Crediario/
ProtectHome=read-only
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target