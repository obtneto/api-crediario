[Unit]
Description=Atualiza status de Vendas e Cobranças e distribuições
After=network-online.target network.target crediario.timer
Wants=network-online.target crediario.timer

[Service]
Type=oneshot
WorkingDirectory=/home/ovidio-neto/Crediario/backend/services
ExecStart=/usr/bin/bash /home/ovidio-neto/Crediario/backend/services/update_status.sh
StandardOutput=append:/home/ovidio-neto/Crediario/backend/services/vendas.log
StandardError=inherit
ProtectSystem=strict
ReadWritePaths=/home/ovidio-neto/Crediario/
ProtectHome=read-only
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target